# ==== Omnia (v-core): базовая конфигурация для ESP32-S3 N16R8 (YD-ESP32-S3) ====
CONFIG_IDF_TARGET="esp32s3"

# Flash 16 МБ, QIO 80 МГц
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Внешняя Octal PSRAM 8 МБ (ТЗ, Том 1, Гл. 1)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Таблица разделов (см. partitions.csv: ota_0 / ota_1 / littlefs)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Производительность и CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PM_ENABLE=y

# HTTP-сервер и WebSocket (ТЗ, Том 4)
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# LVGL: 16-bit цвет, байтовая перестановка для ST7789 (big-endian по SPI)
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_COLOR_16_SWAP=y
