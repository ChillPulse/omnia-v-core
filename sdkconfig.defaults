# ==============================================================================
# Конфигурация ESP-IDF v5.x для платы ESP32-S3-N16R8 (16MB QIO + 8MB Octal PSRAM)
# ==============================================================================
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash 16 МБ @ 80 МГц QIO
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Octal PSRAM 8 МБ @ 80 МГц с выделением через heap_caps_malloc(MALLOC_CAP_SPIRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# Кэши ядра для минимальной латентности декодирования и LVGL 60 FPS
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y

# Схема разделов 16 МБ (Dual OTA + хранилище пресетов/индексов/Web-UI)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Производительность компилятора и частота тиков FreeRTOS 1000 Гц
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
